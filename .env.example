# M2 em diante: chave do provedor de LLM para extração estruturada.
# Única variável obrigatória; sem ela, só a ingestão (M1), os testes e o
# harness com `--sem-llm` rodam.
GEMINI_API_KEY=

# Modelo e espaçamento entre chamadas. O espaçamento alto é deliberado:
# ver "achado real: cota gratuita do Gemini" no README.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MIN_SECONDS_BETWEEN_CALLS=12

# Teto de custo por edital (USD) e timeout por requisição — orçamento
# explícito, ver seção 4 e "não fazer" da proposta.
# CUSTO_MAX_USD_POR_EDITAL=0.05
# TIMEOUT_EXTRACAO_SEGUNDOS=60

# Onde o cache é gravado.
# CACHE_DIR=data/cache
